# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# The labelling stage uses the official Anthropic SDK. Which endpoint it talks
# to is set by LLM_BASE_URL (see tools/crawler/config.ts):
#   - a DeepSeek key  -> https://api.deepseek.com/anthropic  (the default)
#   - a real sk-ant-… -> https://api.anthropic.com
ANTHROPIC_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_MODEL=deepseek-v4-flash
